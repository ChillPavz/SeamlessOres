  "text.autoconfig.seamlessores.option.granite": "Granite variants",
  "text.autoconfig.seamlessores.option.granite.@Tooltip": "Generate granite-backed ore where granite would already contain ore.",
  "text.autoconfig.seamlessores.option.diorite": "Diorite variants",
  "text.autoconfig.seamlessores.option.diorite.@Tooltip": "Generate diorite-backed ore where diorite would already contain ore.",
  "text.autoconfig.seamlessores.option.andesite": "Andesite variants",
  "text.autoconfig.seamlessores.option.andesite.@Tooltip": "Generate andesite-backed ore where andesite would already contain ore.",
  "text.autoconfig.seamlessores.option.tuff": "Tuff variants",
  "text.autoconfig.seamlessores.option.tuff.@Tooltip": "Generate tuff-backed ore instead of the deepslate-textured ore vanilla puts in tuff.",
  "text.autoconfig.seamlessores.option.basalt": "Basalt variants (adds ore)",
  "text.autoconfig.seamlessores.option.basalt.@Tooltip[0]": "Puts gold and quartz in basalt. Vanilla generates NEITHER there,",
  "text.autoconfig.seamlessores.option.basalt.@Tooltip[1]": "so this ADDS ore - most noticeably in basalt deltas. Turn off for vanilla amounts.",
  "text.autoconfig.seamlessores.option.blackstone": "Blackstone variants (adds ore)",
  "text.autoconfig.seamlessores.option.blackstone.@Tooltip[0]": "Puts gold and quartz in blackstone. Vanilla generates NEITHER there,",
  "text.autoconfig.seamlessores.option.blackstone.@Tooltip[1]": "so this ADDS ore. Turn off for vanilla amounts.",
  "text.autoconfig.seamlessores.option.oreVeins": "Restyle large ore veins",
  "text.autoconfig.seamlessores.option.oreVeins.@Tooltip[0]": "The big copper and iron veins are packed with granite and tuff. This makes their ore",
  "text.autoconfig.seamlessores.option.oreVeins.@Tooltip[1]": "match that filler. Cosmetic only - the amount of ore is identical either way.",
  "text.autoconfig.seamlessores.option.createZinc": "Create: zinc variants",
  "text.autoconfig.seamlessores.option.createZinc.@Tooltip": "Generate host-matched zinc ore. Does nothing unless Create is installed.",
  "text.autoconfig.seamlessores.option.mythicUpgrades": "Mythic Upgrades: variants",
  "text.autoconfig.seamlessores.option.mythicMetals": "Mythic Metals: variants",
  "text.autoconfig.seamlessores.option.mythicMetals.@Tooltip": "Generate host-matched Mythic Metals ore. Does nothing unless the mod is installed.",
  "text.autoconfig.seamlessores.option.mythicUpgrades.@Tooltip": "Generate host-matched Mythic Upgrades ore. Does nothing unless the mod is installed.",
  "text.autoconfig.seamlessores.option.zincVeinSize": "Create: zinc vein size",
  "text.autoconfig.seamlessores.option.zincVeinSize.@Tooltip[0]": "How large each zinc vein is. Create's own value is 12; lower means less zinc.",
  "text.autoconfig.seamlessores.option.zincVeinSize.@Tooltip[1]": "Create spreads zinc evenly from Y -63 to 70, so it is equally common everywhere.",
  "text.autoconfig.seamlessores.option.zincVeinSize.@Tooltip[2]": "Set this to 12 to leave Create's generation completely untouched.",
  "text.autoconfig.seamlessores.option.netherGems": "Ruby and sapphire in deltas",
  "text.autoconfig.seamlessores.option.netherGems.@Tooltip[0]": "Scatter Mythic Upgrades ruby and sapphire through basalt deltas, as rarely as",
  "text.autoconfig.seamlessores.option.netherGems.@Tooltip[1]": "ancient debris. Ruby sits around Y 28, sapphire around Y 12, never surface exposed.",
  "text.autoconfig.seamlessores.option.netherGemSize": "Ruby and sapphire amount",
  "text.autoconfig.seamlessores.option.netherGemSize.@Tooltip[0]": "How many gems each find holds. 3 matches ancient debris exactly, 6 is double.",
  "text.autoconfig.seamlessores.option.netherGemSize.@Tooltip[1]": "Higher values make finds both larger and easier to come across.",
  "text.autoconfig.seamlessores.option.netherVeinSize": "Nether vein size",
  "text.autoconfig.seamlessores.option.netherVeinSize.@Tooltip[0]": "How big each nether gold or quartz vein is, as a percent of vanilla. 100 is vanilla.",
  "text.autoconfig.seamlessores.option.netherVeinSize.@Tooltip[1]": "Below its thin basalt crust a delta is netherrack, so some of what you dig through",
  "text.autoconfig.seamlessores.option.netherVeinSize.@Tooltip[2]": "there is vanilla's own ore. Unlike the rarity setting, this affects that too.",
  "text.autoconfig.seamlessores.option.netherOreRarity": "Nether ore rarity",
  "text.autoconfig.seamlessores.option.netherOreRarity.@Tooltip[0]": "One in this many basalt or blackstone veins becomes ore. 1 converts every vein.",
  "text.autoconfig.seamlessores.option.netherOreRarity.@Tooltip[1]": "Basalt deltas run twice the usual gold and quartz, and are almost all basalt,",
  "text.autoconfig.seamlessores.option.netherOreRarity.@Tooltip[2]": "so without this nearly every vein there converted. Vanilla ore is unaffected.",
  "text.autoconfig.seamlessores.option.bastionSafeNether": "Protect bastion remnants",
  "text.autoconfig.seamlessores.option.bastionSafeNether.@Tooltip[0]": "Keep basalt and blackstone ore out of bastion remnants.",
  "text.autoconfig.seamlessores.option.bastionSafeNether.@Tooltip[1]": "Bastions are built from those blocks, so without this their walls can",
  "text.autoconfig.seamlessores.option.bastionSafeNether.@Tooltip[2]": "turn into ore and invite you to mine the structure apart."
}
